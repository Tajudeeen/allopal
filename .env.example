# For an offline test/demo environment, mock_* credentials are also supported by the application and test suite.
# Database (Prisma SQLite by default; can point to PostgreSQL if desired)
DATABASE_URL="file:./prisma/dev.db"

# PayPal Sandbox API Credentials (Server-side ONLY)
PAYPAL_CLIENT_ID="your_paypal_sandbox_client_id"
PAYPAL_CLIENT_SECRET="your_paypal_sandbox_client_secret"
PAYPAL_API_BASE_URL="https://api-m.sandbox.paypal.com"

# Gemini 2.5 Flash API key (Server-side ONLY)
AI_API_KEY="your_gemini_api_key"
