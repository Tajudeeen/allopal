{
  "name": "allopal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"try { require('fs').rmSync('.next', { recursive: true, force: true }); } catch {}\"",
    "dev": "next dev",
    "build": "node ./node_modules/prisma/build/index.js generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:watch": "node scripts/test.mjs --watch",
    "prisma:generate": "node ./node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node ./node_modules/prisma/build/index.js migrate dev",
    "prisma:seed": "node --import tsx prisma/seed.ts",
    "demo:reset": "node --import tsx prisma/seed.ts",
    "db:deploy": "node scripts/db-deploy.mjs",
    "worker": "node --import tsx scripts/reconcile.ts",
    "worker:once": "node --import tsx scripts/reconcile.ts --once",
    "release:check": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "@prisma/client": "^7.10.1",
    "ag-studio": "3.0.0",
    "ag-studio-react": "3.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "next": "^14.2.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.8.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.20",
    "postcss": "^8.4.47",
    "prisma": "^8.0.0-rc.33",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite-tsconfig-paths": "^5.1.1",
    "vitest": "^2.1.4"
  }
}
