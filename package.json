{
  "name": "allopal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"try { require('fs').rmSync('.next', { recursive: true, force: true }); } catch {}\"",
    "dev": "next dev",
    "build": "node scripts/prisma.mjs generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:watch": "node scripts/test.mjs --watch",
    "prisma:generate": "node scripts/prisma.mjs generate",
    "prisma:migrate": "node scripts/prisma.mjs migrate dev",
    "prisma:seed": "node --import tsx prisma/seed.ts",
    "demo:reset": "node --import tsx prisma/seed.ts",
    "db:deploy": "node scripts/db-deploy.mjs",
    "worker": "node --import tsx scripts/reconcile.ts",
    "worker:once": "node --import tsx scripts/reconcile.ts --once",
    "release:check": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "ag-studio": "3.0.0",
    "ag-studio-react": "3.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "next": "15.5.29",
    "react": "^18.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^2.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.8.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.29",
    "postcss": "8.5.32",
    "prisma": "5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "4.1.12",
    "vite": "6.4.6"
  },
  "overrides": {
    "postcss": "8.5.32",
    "minimatch": "11.0.1"
  }
}
