# Absolute SQLite path on durable storage. Never use an ephemeral serverless filesystem.
DATABASE_URL="file:./dev.db"
# Public HTTPS origin used for PayPal return/cancel URLs in production.
APP_BASE_URL=""
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ALLOPAL_DEMO_ACCESS_KEY=""
# Optional HTTP scheduler credential. The local worker does not need this token.
RECONCILE_TOKEN=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_API_BASE_URL="https://api-m.sandbox.paypal.com"
PAYPAL_WEBHOOK_ID=""
AI_API_KEY=""
# Browser-visible AG Studio license, supplied by AG Grid. Never put provider API secrets here.
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=""
